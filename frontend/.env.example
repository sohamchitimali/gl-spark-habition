# ==============================================================================
# Habition Frontend Environment Variables
# ==============================================================================
# Local development default:
# VITE_API_BASE_URL=http://localhost:8080

# Production Cloudflare Pages environment variable:
# In Cloudflare Pages Dashboard -> Settings -> Environment Variables:
# Add VITE_API_BASE_URL with the public URL of your Render API Gateway
VITE_API_BASE_URL=https://habition-api.onrender.com

# Google SSO (Optional - obtain from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
