# ==============================================================================
# Habition Rust Backend Environment Variables
# Ultra-lightweight monolithic service (<30MB RAM footprint, ~55MB with bundled Meilisearch)
# ==============================================================================

# Server Port
PORT=8080

# Database Configuration (PostgreSQL / Layerbase)
# Option A: Single standard connection URL (Recommended for Layerbase, Neon, Supabase)
DATABASE_URL=postgres://postgres:password@localhost:5432/habition?sslmode=prefer

# Option B: Discrete DB parameters (Backwards-compatible with Java microservices setup)
# DB_HOST=your-layerbase-host.layerbase.com
# DB_PORT=5432
# DB_NAME=habition
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_SSLMODE=require

# JWT Secret (Min 32 characters for HS256 security)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Allowed Origins (Comma-separated, Netlify frontend URL)
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,https://your-app.netlify.app

# Base URL for unsubscribe links / links in emails
APP_BASE_URL=http://localhost:8080

# Email (SMTP) Configuration (Optional - falls back to logging emails in terminal)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Meilisearch Search Engine Configuration
# When deployed on Render, Meilisearch is bundled directly inside the container on 127.0.0.1:7700
# Set ENABLE_MEILISEARCH=false to disable Meilisearch and use pure PostgreSQL search directly
ENABLE_MEILISEARCH=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=

# Google Gemini AI (Optional - falls back to deterministic rule-based insights)
GEMINI_API_KEY=
