# ==============================================================================
# Habition Rust Backend Environment Variables
# Ultra-lightweight monolithic service (<30MB RAM footprint)
# ==============================================================================

# Server Port
PORT=8080

# Database Configuration (PostgreSQL)
# Option A: Single standard connection URL (Recommended for Neon, Supabase, Render, Railway)
DATABASE_URL=postgres://postgres:password@localhost:5432/habition?sslmode=prefer

# Option B: Discrete DB parameters (Backwards-compatible with Java microservices setup)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=habition
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_SSLMODE=prefer

# JWT Secret (Min 32 characters for HS256 security)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Allowed Origins (Comma-separated)
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,https://habition.pages.dev

# Base URL for unsubscribe links / links in emails
APP_BASE_URL=http://localhost:8080

# Email (SMTP) Configuration (Optional - falls back to logging emails in terminal)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Meilisearch (Optional - falls back automatically to PostgreSQL ILIKE + Geo Jaccard search)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Google Gemini AI (Optional - falls back to deterministic rule-based insights)
GEMINI_API_KEY=
