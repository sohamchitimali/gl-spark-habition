# ==============================================================================
# Habition Environment Variables Template (.env.example)
# Mirrored from .env for local development and cloud production (Layerbase/Render)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Layerbase)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_SSLMODE=prefer

# Optional single connection URL (Takes priority if provided)
# DATABASE_URL=postgres://postgres:password@localhost:5432/postgres?sslmode=prefer

# Legacy multi-schema URLs (Supported for backwards-compatibility with Java setup)
DB_URL_USERS=jdbc:postgresql://localhost:5432/habition_users
DB_URL_GROUPS=jdbc:postgresql://localhost:5432/habition_groups
DB_URL_HABITS=jdbc:postgresql://localhost:5432/habition_habits
DB_URL_NOTIFICATIONS=jdbc:postgresql://localhost:5432/habition_notifications

# ------------------------------------------------------------------------------
# 2. CORS & Frontend Integration
# ------------------------------------------------------------------------------
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,https://your-site.netlify.app
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Microservice / Server Network Configuration
# ------------------------------------------------------------------------------
PORT=8080
API_GATEWAY_URL=http://localhost:8080
AUTH_SERVICE_URL=http://localhost:8080
GROUP_SERVICE_URL=http://localhost:8080
HABIT_SERVICE_URL=http://localhost:8080
NOTIFICATION_SERVICE_URL=http://localhost:8080
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_HOSTNAME=localhost

# ------------------------------------------------------------------------------
# 4. Email / SMTP Configuration (Gmail App Password)
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_16_char_app_password

# ------------------------------------------------------------------------------
# 5. Search & AI Configuration
# ------------------------------------------------------------------------------
ENABLE_MEILISEARCH=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key
MEILISEARCH_API_KEY=your_meilisearch_master_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# ------------------------------------------------------------------------------
# 6. Security Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
HMAC_SECRET=default-dev-secret-key-123456
OTP_SECRET=3b497a6d9e81b672a9b3d0c4f826317b
# Google OAuth Client ID (Optional - for verifying Google SSO token audience)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
