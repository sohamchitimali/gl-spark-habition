# ==============================================================================
# Habition Production Environment Variables (Layerbase + Render)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Layerbase Serverless PostgreSQL
# ------------------------------------------------------------------------------
# Recommended: Set Host, Database Name, and Credentials.
# The microservices will automatically build their JDBC URLs and map to their schemas!
DB_HOST=your-layerbase-host.layerbase.com
DB_NAME=your_database_name
DB_PORT=5432
DB_USERNAME=your_layerbase_user
DB_PASSWORD=your_layerbase_password
DB_SSLMODE=require

# Optional Overrides (only if you want custom JDBC connection strings per service):
# DB_URL_USERS=jdbc:postgresql://your-layerbase-host:5432/your_database?sslmode=require&currentSchema=habition_users
# DB_URL_GROUPS=jdbc:postgresql://your-layerbase-host:5432/your_database?sslmode=require&currentSchema=habition_groups
# DB_URL_HABITS=jdbc:postgresql://your-layerbase-host:5432/your_database?sslmode=require&currentSchema=habition_habits
# DB_URL_NOTIFICATIONS=jdbc:postgresql://your-layerbase-host:5432/your_database?sslmode=require&currentSchema=habition_notifications

# ------------------------------------------------------------------------------
# 2. CORS & Cloudflare Pages Integration
# ------------------------------------------------------------------------------
# Add your Cloudflare Pages domain (and custom domain if applicable)
FRONTEND_URLS=https://habition.pages.dev,https://your-custom-domain.com
FRONTEND_URL=https://habition.pages.dev

# ------------------------------------------------------------------------------
# 3. Microservice Network Configuration (Render / Cloud)
# ------------------------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_HOSTNAME=localhost

# ------------------------------------------------------------------------------
# 4. Search & AI Configuration
# ------------------------------------------------------------------------------
MEILISEARCH_HOST=https://your-meilisearch-instance.com
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 5. Security Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=generate_a_secure_64_character_hex_key_for_production
HMAC_SECRET=generate_a_secure_random_hmac_secret_for_production
OTP_SECRET=generate_a_secure_otp_secret_key_for_production
